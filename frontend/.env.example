# Option A (recommended for dev): use Vite's proxy, defined in vite.config.ts.
# The browser only ever calls "/api/v1", which Vite forwards server-side to
# Laravel. No CORS headers are ever needed with this approach.
VITE_API_BASE_URL=/api/v1

# Option B: call Laravel directly from the browser. This DOES require the
# CORS config change described in backend-cors-changes/.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
